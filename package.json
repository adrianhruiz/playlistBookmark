{
  "name": "playlistbookmark",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that bookmarks where you left off in each Spotify playlist",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:telegram": "node scripts/telegram-setup.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianhruiz/playlistBookmark.git"
  },
  "license": "MIT"
}
