{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playlistbookmark",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    // Create it with `npx wrangler kv namespace create KV` and paste the id here.
    { "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
  // Secrets (never commit them): SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET,
  // TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, BASE_URL.
  // Local: .dev.vars · Production: `npx wrangler secret put <NAME>`.
}
